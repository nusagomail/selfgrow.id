---
import ItemCard from "../components/ItemCard.astro";
import Base from "../layouts/Base.astro";
import { appUrl, getCategories, getItems } from "../lib/api";

// Beranda etalase seperti YouTube (D35): semua konten terbit tampil, difilter per kategori lewat
// ?kategori=slug (tanpa JavaScript). Gratis bisa langsung dicoba, Premium untuk pelanggan.
const [categories, items] = await Promise.all([getCategories(), getItems()]);
const active = Astro.url.searchParams.get("kategori") ?? "semua";
const withContent = categories.filter((c) => items.some((i) => i.category?.slug === c.slug));
const shown = active === "semua" ? items : items.filter((i) => i.category?.slug === active);
const activeCat = categories.find((c) => c.slug === active);
const freeCount = items.filter((i) => i.access !== "premium").length;

const faqs = [
  {
    q: "Apa itu SelfGrow?",
    a: "SelfGrow adalah kumpulan ebook interaktif, tools, tracker, template, dan program bertahap untuk pengembangan diri, dalam Bahasa Indonesia. Semua dipakai langsung di HP atau laptop.",
  },
  {
    q: "Apa bedanya Gratis dan Premium?",
    a: "Konten berlabel Gratis bisa dipakai siapa saja yang sudah masuk dengan Google. Konten berlabel Bab gratis bisa dibaca bab pertamanya tanpa login. Konten Premium terbuka penuh setelah berlangganan.",
  },
  {
    q: "Berapa biaya berlangganan?",
    a: "Rp100.000 per bulan untuk semua konten Premium di semua kategori. Paket tahunan setara 10 bulan, dan 500 pendaftar pertama mendapat harga founding member.",
  },
  {
    q: "Bisa dipakai di HP?",
    a: "Bisa. SelfGrow dirancang untuk HP lebih dulu dan ringan di koneksi 4G.",
  },
];
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
const siteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "SelfGrow",
  url: new URL("/", Astro.site ?? Astro.url.origin).toString(),
  inLanguage: "id-ID",
};
---

<Base
  title={activeCat ? `${activeCat.name} | SelfGrow` : "SelfGrow: Bertumbuh Menjadi Lebih Baik"}
  description="Ebook interaktif, tools, tracker, dan template untuk keuangan, kebiasaan, produktivitas, karier, dan lainnya. Ada yang gratis, sisanya satu langganan untuk semua."
  categories={categories}
  current={activeCat?.slug}
  jsonLd={[siteLd, faqLd]}
>
  <section class="intro">
    <div class="container intro-inner">
      <div>
        <h1>Bertumbuh sedikit <span class="mark">setiap hari.</span></h1>
        <p class="lead">
          Ebook, tools, dan template untuk langsung dipraktikkan. {freeCount > 0
            ? `${freeCount} konten bisa dicoba gratis.`
            : "Mulai dari bab gratis."}
        </p>
      </div>
      <a href={appUrl("/masuk?auto=1")} class="btn btn-gold">Mulai gratis</a>
    </div>
  </section>

  <section class="container feed" id="konten">
    <nav class="chips" aria-label="Filter kategori">
      <a href="/#konten" class="chip" aria-current={active === "semua" ? "page" : undefined}>
        Semua <span class="count">{items.length}</span>
      </a>
      {withContent.map((c) => (
        <a href={`/?kategori=${c.slug}#konten`} class="chip" aria-current={active === c.slug ? "page" : undefined}>
          {c.name} <span class="count">{items.filter((i) => i.category?.slug === c.slug).length}</span>
        </a>
      ))}
      <a href="/kategori" class="chip all">Semua kategori →</a>
    </nav>

    {shown.length > 0 ? (
      <div class="grid feed-grid">
        {shown.map((i) => <ItemCard item={i} />)}
      </div>
    ) : (
      <div class="empty">
        <h2>Konten sedang disiapkan</h2>
        <p class="muted">
          Ebook, tools, dan template pertama sedang ditulis. Daftar sekarang supaya kamu dikabari saat
          terbit dan mendapat harga founding member.
        </p>
        <a href={appUrl("/masuk?auto=1")} class="btn btn-primary">Daftar gratis</a>
      </div>
    )}
  </section>

  <section class="strip">
    <div class="container strip-inner">
      <div>
        <p class="eyebrow on-dark">Premium</p>
        <h2>Buka semua konten Premium dengan satu langganan</h2>
        <p class="strip-lead">Rp100.000/bulan untuk semua kategori. 500 pendaftar pertama mendapat harga founding member.</p>
      </div>
      <div class="strip-cta">
        <a href="/harga" class="btn btn-gold">Lihat harga</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container faq-wrap">
      <div class="section-head">
        <p class="eyebrow">Pertanyaan umum</p>
        <h2>Yang sering ditanyakan</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .intro {
    background:
      radial-gradient(900px 400px at 90% -20%, rgb(60 150 49 / 35%), transparent 60%),
      var(--hero-bg);
    color: var(--hero-ink);
    padding-block: clamp(28px, 5vw, 48px);
  }
  .intro-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .intro h1 {
    color: #fff;
    font-size: clamp(1.7rem, 4.5vw, 2.6rem);
  }
  .mark {
    color: var(--gold);
  }
  .intro .lead {
    color: var(--hero-muted);
    margin-top: 8px;
  }
  .feed {
    padding-block: 24px clamp(40px, 6vw, 72px);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: thin;
    position: sticky;
    top: calc(69px + env(safe-area-inset-top, 0px));
    z-index: 5;
    background: var(--bg);
    padding-top: 8px;
  }
  .chips .chip {
    flex-shrink: 0;
  }
  .chips .all {
    border-style: dashed;
  }
  .feed-grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
  }
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    padding: clamp(32px, 6vw, 56px) 20px;
    border: 1.5px dashed var(--line);
    border-radius: var(--radius);
  }
  .empty h2 {
    font-size: 1.3rem;
  }
  .empty p {
    max-width: 52ch;
  }
  .strip {
    background: var(--hero-bg);
    color: var(--hero-ink);
    padding-block: clamp(32px, 6vw, 56px);
  }
  .strip-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .strip h2 {
    color: #fff;
    font-size: clamp(1.3rem, 3vw, 1.8rem);
  }
  .on-dark {
    color: var(--gold);
  }
  .strip-lead {
    color: var(--hero-muted);
    margin-top: 6px;
  }
  .faq {
    display: grid;
    gap: 10px;
    max-width: 760px;
  }
  .faq details {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 4px 18px;
  }
  .faq summary {
    cursor: pointer;
    font-weight: 700;
    padding: 14px 0;
  }
  .faq details p {
    padding-bottom: 16px;
    color: var(--muted);
  }
</style>
