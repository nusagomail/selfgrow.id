---
import CategoryCard from "../components/CategoryCard.astro";
import Base from "../layouts/Base.astro";
import { appUrl, getCategories } from "../lib/api";

const categories = await getCategories();
const topicCount = categories.reduce((n, c) => n + c.topics.length, 0);

const faqs = [
  {
    q: "Apa itu SelfGrow?",
    a: "SelfGrow adalah platform pengembangan diri berisi ebook interaktif, tools, tracker, template, dan program bertahap. Semuanya dipakai langsung di HP atau laptop, dalam Bahasa Indonesia.",
  },
  {
    q: "Apa bedanya dengan membaca buku biasa?",
    a: "Setiap ebook dilengkapi alat untuk langsung praktik: kalkulator, tracker harian dengan streak, dan template yang bisa diunduh sebagai Word, PDF, atau Excel. Kamu tidak hanya membaca, tapi juga mengerjakan.",
  },
  {
    q: "Berapa biayanya?",
    a: "Satu langganan Rp100.000 per bulan membuka semua kategori. Paket tahunan setara 10 bulan. Pendaftar awal mendapat harga founding member yang terkunci selama langganan aktif.",
  },
  {
    q: "Apakah bisa dicoba gratis?",
    a: "Bisa. Bab pertama setiap ebook gratis dibaca setelah masuk dengan akun Google, tanpa kartu kredit.",
  },
  {
    q: "Bisa dipakai di HP?",
    a: "Bisa. SelfGrow dirancang untuk HP lebih dulu, ringan di koneksi 4G, dan bisa dipasang di layar utama seperti aplikasi.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
const siteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "SelfGrow",
  url: new URL("/", Astro.site ?? Astro.url.origin).toString(),
  inLanguage: "id-ID",
};
const week = ["S", "S", "R", "K", "J", "S", "M"];
---

<Base
  title="SelfGrow: Bertumbuh Menjadi Lebih Baik"
  description="Ebook interaktif, tools, tracker, dan template untuk keuangan, kebiasaan, produktivitas, karier, dan lainnya. Satu langganan untuk semua kategori."
  categories={categories}
  jsonLd={[siteLd, faqLd]}
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow on-dark">Ebook interaktif · Tools · Template</p>
        <h1>Bertumbuh sedikit <span class="mark">setiap hari.</span></h1>
        <p class="hero-lead">
          Baca satu bab, langsung praktik dengan alatnya, lalu pantau kemajuanmu. Untuk urusan uang,
          kebiasaan, kerja, sampai hubungan, dalam satu langganan.
        </p>
        <div class="hero-cta">
          <a href={appUrl("/masuk")} class="btn btn-gold">Mulai gratis</a>
          <a href="#kategori" class="btn btn-outline-light">Lihat kategori</a>
        </div>
        <p class="hero-note">Bab pertama gratis · Masuk dengan Google · Tanpa kartu kredit</p>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="tile streak">
          <div class="tile-head">
            <span class="tile-label">Tracker kebiasaan</span>
            <span class="streak-num">12 hari</span>
          </div>
          <div class="week">
            {week.map((d, i) => (
              <span class:list={["day", { done: i < 5, today: i === 5 }]}>
                <span class="dot"></span>
                <span class="d">{d}</span>
              </span>
            ))}
          </div>
        </div>
        <div class="tile budget">
          <span class="tile-label">Kalkulator anggaran</span>
          <div class="bar">
            <span style="flex:50" class="b1"></span>
            <span style="flex:30" class="b2"></span>
            <span style="flex:20" class="b3"></span>
          </div>
          <div class="legend">
            <span><i class="b1"></i>Kebutuhan 50%</span>
            <span><i class="b2"></i>Keinginan 30%</span>
            <span><i class="b3"></i>Tabungan 20%</span>
          </div>
        </div>
        <div class="tile files">
          <span class="tile-label">Template siap unduh</span>
          <div class="file-row">
            <span class="file docx">DOCX</span>
            <span class="file pdf">PDF</span>
            <span class="file xlsx">XLSX</span>
          </div>
          <span class="file-name">Rencana Mingguan.xlsx</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="kategori">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{categories.length} kategori · {topicCount} topik</p>
        <h2>Mulai dari masalah yang paling terasa</h2>
        <p class="lead">Pilih satu kategori. Setiap topik punya ebook untuk dipahami, tool untuk dipraktikkan, dan template untuk dipakai.</p>
      </div>
      <div class="grid cats">
        {categories.map((c, i) => <CategoryCard category={c} index={i + 1} />)}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Bukan sekadar bacaan</p>
        <h2>Tiga cara bertumbuh, saling melengkapi</h2>
      </div>
      <div class="kinds">
        <article class="kind">
          <span class="kind-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z" /><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5" /></svg>
          </span>
          <h3>Ebook interaktif</h3>
          <p class="muted">Dibaca per bab, singkat dan langsung ke praktik. Progres dan penanda tersimpan otomatis.</p>
        </article>
        <article class="kind">
          <span class="kind-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M8 7h8M8 11h2M12 11h2M16 11h0M8 15h2M12 15h2M8 19h8" /></svg>
          </span>
          <h3>Tools &amp; tracker</h3>
          <p class="muted">Kalkulator, penilaian, dan tracker harian dengan streak, supaya perubahan kecil terasa nyata.</p>
        </article>
        <article class="kind">
          <span class="kind-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h4" /></svg>
          </span>
          <h3>Template siap pakai</h3>
          <p class="muted">Isi formulir singkat, unduh hasilnya sebagai Word, PDF, atau Excel dengan namamu di dalamnya.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container steps-wrap">
      <div class="section-head">
        <p class="eyebrow">Cara kerja</p>
        <h2>Dari bingung jadi jalan, dalam tiga langkah</h2>
      </div>
      <ol class="steps">
        <li><span class="step-num">1</span><div><h3>Pilih masalahmu</h3><p class="muted">Misalnya gaji cepat habis atau sulit konsisten olahraga.</p></div></li>
        <li><span class="step-num">2</span><div><h3>Baca dan praktikkan</h3><p class="muted">Satu bab sehari, lalu pakai tool atau template yang menyertainya.</p></div></li>
        <li><span class="step-num">3</span><div><h3>Pantau kemajuan</h3><p class="muted">Tracker, streak, dan program bertahap menjaga kamu tetap di jalur.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section alt">
    <div class="container price">
      <div class="price-copy">
        <p class="eyebrow">Harga</p>
        <h2>Satu langganan, semua kategori</h2>
        <p class="lead">Tidak perlu membeli ebook satu per satu. Semua konten baru setiap minggu ikut terbuka.</p>
        <a href="/harga" class="btn btn-ghost">Lihat detail harga</a>
      </div>
      <div class="price-card">
        <p class="plan">Bulanan</p>
        <p class="amount"><span class="rp">Rp</span>100.000<span class="per">/bulan</span></p>
        <ul>
          <li>Semua ebook, tools, template, dan program</li>
          <li>Tahunan setara 10 bulan</li>
          <li>Harga founding member untuk 500 pendaftar pertama</li>
        </ul>
        <a href={appUrl("/masuk")} class="btn btn-primary">Daftar dulu, gratis</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container faq-wrap">
      <div class="section-head">
        <p class="eyebrow">Pertanyaan umum</p>
        <h2>Yang sering ditanyakan</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="final">
    <div class="container final-inner">
      <h2>Mulai dari satu bab hari ini.</h2>
      <a href={appUrl("/masuk")} class="btn btn-gold">Mulai gratis</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    background:
      radial-gradient(1000px 500px at 85% -10%, rgb(60 150 49 / 35%), transparent 60%),
      var(--hero-bg);
    color: var(--hero-ink);
    padding-block: clamp(48px, 8vw, 96px);
    overflow: hidden;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .on-dark {
    color: var(--gold);
  }
  .hero h1 {
    color: #fff;
  }
  .mark {
    color: var(--gold);
  }
  .hero-lead {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--hero-muted);
    max-width: 52ch;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn-outline-light {
    border-color: rgb(255 255 255 / 35%);
    color: #fff;
  }
  .hero-note {
    font-size: 0.88rem;
    color: var(--hero-muted);
  }
  .hero-visual {
    display: grid;
    gap: 14px;
    grid-template-columns: 1fr 1fr;
  }
  .tile {
    background: #fff;
    color: #10241a;
    border-radius: var(--radius);
    padding: 16px;
    box-shadow: 0 18px 40px rgb(0 0 0 / 25%);
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .tile-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: #4f6357;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .tile-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .streak {
    grid-column: 1 / -1;
  }
  .streak-num {
    font-weight: 800;
    font-size: 1.3rem;
    color: #1d7a34;
  }
  .week {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
  }
  .day {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    color: #4f6357;
  }
  .dot {
    width: 100%;
    max-width: 34px;
    aspect-ratio: 1;
    border-radius: 10px;
    background: #e2f0e4;
  }
  .day.done .dot {
    background: #1d7a34;
  }
  .day.today .dot {
    background: #f4ac13;
  }
  .bar {
    display: flex;
    height: 14px;
    border-radius: 99px;
    overflow: hidden;
    gap: 3px;
  }
  .b1 {
    background: #073e1f;
  }
  .b2 {
    background: #3c9631;
  }
  .b3 {
    background: #f4ac13;
  }
  .legend {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.8rem;
  }
  .legend i {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    margin-right: 6px;
  }
  .file-row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .file {
    font-size: 0.72rem;
    font-weight: 800;
    padding: 6px 8px;
    border-radius: 6px;
    color: #fff;
  }
  .docx {
    background: #2f6fa8;
  }
  .pdf {
    background: #b23a2e;
  }
  .xlsx {
    background: #1d7a34;
  }
  .file-name {
    font-size: 0.85rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .alt {
    background: var(--surface-alt);
  }
  @media (min-width: 1100px) {
    .cats {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  @media (min-width: 560px) and (max-width: 1099px) {
    .cats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .kinds {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .kind {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .kind-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: var(--surface);
    color: var(--primary);
    border: 1px solid var(--line);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .steps li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .steps h3 {
    margin-bottom: 4px;
  }
  .step-num {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--gold);
    color: var(--green-950);
    font-weight: 800;
    display: grid;
    place-items: center;
  }

  .price {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
    gap: 40px;
    align-items: center;
  }
  .price-copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
  }
  .price-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 28px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .plan {
    font-weight: 700;
    color: var(--muted);
  }
  .amount {
    font-size: clamp(2.2rem, 6vw, 2.8rem);
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .rp {
    font-size: 0.45em;
    vertical-align: super;
    margin-right: 4px;
  }
  .per {
    font-size: 0.4em;
    font-weight: 600;
    color: var(--muted);
    margin-left: 4px;
  }
  .price-card ul {
    margin: 0;
    padding-left: 20px;
    display: grid;
    gap: 6px;
    color: var(--muted);
  }

  .faq {
    display: grid;
    gap: 10px;
    max-width: 760px;
  }
  .faq details {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 4px 18px;
  }
  .faq summary {
    cursor: pointer;
    font-weight: 700;
    padding: 14px 0;
    list-style-position: outside;
  }
  .faq details p {
    padding-bottom: 16px;
    color: var(--muted);
  }

  .final {
    background: var(--green-700);
    color: #fff;
    padding-block: 48px;
  }
  .final-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .final h2 {
    color: #fff;
  }

  @media (max-width: 900px) {
    .hero-inner,
    .price {
      grid-template-columns: minmax(0, 1fr);
    }
    .kinds,
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 420px) {
    .hero-visual {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-cta .btn {
      flex: 1;
    }
  }
</style>
