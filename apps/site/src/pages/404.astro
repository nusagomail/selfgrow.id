---
import Base from "../layouts/Base.astro";

Astro.response.status = 404;
---

<Base title="Halaman tidak ditemukan | SelfGrow" description="Halaman yang kamu cari tidak ada.">
  <section class="container nf">
    <p class="eyebrow">404</p>
    <h1>Halaman ini tidak ditemukan</h1>
    <p class="lead">Mungkin tautannya salah atau halamannya sudah dipindah.</p>
    <div class="cta">
      <a href="/" class="btn btn-primary">Ke beranda</a>
      <a href="/kategori" class="btn btn-ghost">Lihat kategori</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(64px, 12vw, 128px);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
