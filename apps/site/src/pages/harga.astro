---
import Base from "../layouts/Base.astro";
import { appUrl } from "../lib/api";

const plans = [
  {
    name: "Bulanan",
    was: "199.000",
    price: "129.000",
    per: "/bulan",
    save: "Harga perkenalan, hemat 35%",
    note: "Bebas berhenti kapan saja.",
    features: [
      "Semua ebook, tools, template, dan program",
      "Konten baru setiap minggu",
      "Dipakai di HP dan laptop",
    ],
  },
  {
    name: "Tahunan",
    was: "1.548.000",
    price: "990.000",
    per: "/tahun",
    save: "Dibanding 12 × Rp129.000",
    note: "Setara Rp82.500 per bulan, hemat lebih dari 4 bulan.",
    features: [
      "Semua yang ada di paket bulanan",
      "Hemat Rp558.000 per tahun",
      "Cocok untuk program jangka panjang",
    ],
    best: true,
  },
];
---

<Base title="Harga langganan | SelfGrow" description="Satu langganan Rp129.000 per bulan untuk semua ebook, tools, template, dan program SelfGrow. Paket tahunan Rp990.000.">
  <section class="head">
    <div class="container">
      <p class="eyebrow">Harga</p>
      <h1>Satu langganan untuk semua kategori</h1>
      <p class="lead">Pendaftaran berbayar segera dibuka. Daftar sekarang secara gratis untuk mencoba bab pertama setiap ebook.</p>
    </div>
  </section>
  <section class="container plans">
    {plans.map((p) => (
      <article class:list={["plan", { best: p.best }]}>
        {p.best && <span class="badge">Paling hemat</span>}
        <h2>{p.name}</h2>
        <p class="was"><s aria-label={`Harga normal Rp${p.was}`}>Rp{p.was}</s> <span class="save">{p.save}</span></p>
        <p class="amount"><span class="rp">Rp</span>{p.price}<span class="per">{p.per}</span></p>
        <p class="muted">{p.note}</p>
        <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
        <a href={appUrl("/masuk?auto=1")} class:list={["btn", p.best ? "btn-primary" : "btn-ghost"]}>Daftar gratis dulu</a>
      </article>
    ))}
  </section>
</Base>

<style>
  .head {
    background: var(--surface-alt);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(32px, 6vw, 64px);
  }
  .head .container {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 820px;
    gap: 20px;
    padding-block: 40px clamp(48px, 8vw, 96px);
    align-items: stretch;
  }
  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    min-width: 0;
  }
  .plan.best {
    border: 2px solid var(--primary);
    box-shadow: var(--shadow);
  }
  .badge {
    position: absolute;
    top: -12px;
    left: 24px;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 99px;
    background: var(--primary);
    color: var(--primary-ink);
  }
  .plan h2 {
    font-size: 1.2rem;
  }
  .amount {
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .was {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    margin-bottom: -6px;
  }
  .was s {
    color: var(--muted);
    font-size: 1.05rem;
    font-variant-numeric: tabular-nums;
  }
  .save {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 99px;
    background: var(--gold);
    color: var(--green-950);
  }
  .rp {
    font-size: 0.45em;
    vertical-align: super;
    margin-right: 4px;
  }
  .per {
    font-size: 0.42em;
    font-weight: 600;
    opacity: 0.75;
    margin-left: 4px;
  }
  ul {
    margin: 0;
    padding-left: 20px;
    display: grid;
    gap: 6px;
    color: var(--muted);
  }
  .plan .btn {
    margin-top: auto;
  }
  @media (max-width: 900px) {
    .plans {
      grid-template-columns: minmax(0, 1fr);
      max-width: 520px;
    }
  }
</style>
