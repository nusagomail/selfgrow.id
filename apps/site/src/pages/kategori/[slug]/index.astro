---
import CategoryView from "../../../components/CategoryView.astro";
import Base from "../../../layouts/Base.astro";
import { getCategory } from "../../../lib/api";

const slug = Astro.params.slug ?? "";
const data = await getCategory(slug);
if (!data) return Astro.rewrite("/404");
const { category } = data;
const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Beranda",
      item: new URL("/", Astro.site ?? Astro.url.origin).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Kategori",
      item: new URL("/kategori", Astro.site ?? Astro.url.origin).toString(),
    },
    { "@type": "ListItem", position: 3, name: category.name },
  ],
};
---

<Base
  title={`${category.name}: ebook, tools, dan template | SelfGrow`}
  description={`${category.hook ?? ""} ${category.description ?? ""}`.trim()}
  current={slug}
  jsonLd={[crumbs]}
>
  <CategoryView data={data} />
</Base>
