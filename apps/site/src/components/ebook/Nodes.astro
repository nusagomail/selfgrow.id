---
/**
 * Render isi bab ebook (JSON yang lolos `ebookDocSchema`) untuk halaman publik, setara
 * `@selfgrow/renderer`: hanya node yang dikenal, tautan & gambar diperiksa ulang, tanpa HTML mentah.
 */
import { barWidths, formatChartValue } from "@selfgrow/renderer/interactive-format";
import { tableLayout } from "@selfgrow/renderer/table";
import {
  CALLOUT_LABELS,
  type EbookNode,
  quizHint,
  quizLabel,
  quizMode,
  quizOptionPoints,
} from "@selfgrow/shared";
import { appUrl } from "../../lib/api";
import Marked from "./Marked.astro";

interface Props {
  nodes?: EbookNode[];
}
const { nodes = [] } = Astro.props;
const Self = Astro.self;
const SAFE_IMG = /^(https:\/\/[^\s]+|\/api\/v1\/assets\/[A-Za-z0-9_-]+)$/;
// Gambar isi konten dilayani dari domain etalase sendiri lewat /gambar/{id} (D38).
const imgSrc = (src: string) =>
  src.startsWith("/api/v1/assets/") ? `/gambar/${src.slice("/api/v1/assets/".length)}` : src;
---

{
  nodes.map((n) =>
    n.type === "text" ? (
      <Marked text={n.text} marks={n.marks} />
    ) : n.type === "paragraph" ? (
      <p><Self nodes={n.content} /></p>
    ) : n.type === "heading" ? (
      n.attrs.level === 2 ? (
        <h2><Self nodes={n.content} /></h2>
      ) : n.attrs.level === 3 ? (
        <h3><Self nodes={n.content} /></h3>
      ) : (
        <h4><Self nodes={n.content} /></h4>
      )
    ) : n.type === "bulletList" ? (
      <ul><Self nodes={n.content} /></ul>
    ) : n.type === "orderedList" ? (
      <ol start={n.attrs?.start}><Self nodes={n.content} /></ol>
    ) : n.type === "listItem" ? (
      <li><Self nodes={n.content} /></li>
    ) : n.type === "blockquote" ? (
      n.attrs?.cite?.trim() ? (
        <figure class="quote"><blockquote><Self nodes={n.content} /></blockquote><figcaption>{n.attrs.cite.trim()}</figcaption></figure>
      ) : (
        <blockquote><Self nodes={n.content} /></blockquote>
      )
    ) : n.type === "horizontalRule" ? (
      <hr />
    ) : n.type === "hardBreak" ? (
      <br />
    ) : n.type === "image" && SAFE_IMG.test(n.attrs.src) ? (
      <figure>
        <img src={imgSrc(n.attrs.src)} alt={n.attrs.alt ?? ""} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
        {n.attrs.title && <figcaption>{n.attrs.title}</figcaption>}
      </figure>
    ) : n.type === "table" ? (
      (() => {
        // Label kolom per sel: tabel lebar tampil sebagai kartu di layar sempit (D39).
        const layout = tableLayout(n);
        return (
          <div class="table-wrap">
            <table class={layout.wide ? "wide" : undefined}>
              <tbody>
                {n.content.map((row) =>
                  row.type === "tableRow" ? (
                    <tr>
                      {row.content.map((cell, ci) =>
                        cell.type === "tableHeader" ? (
                          <th colspan={cell.attrs?.colspan} rowspan={cell.attrs?.rowspan} data-label={layout.labels[ci] || undefined}><Self nodes={cell.content} /></th>
                        ) : cell.type === "tableCell" ? (
                          <td colspan={cell.attrs?.colspan} rowspan={cell.attrs?.rowspan} data-label={layout.labels[ci] || undefined}><Self nodes={cell.content} /></td>
                        ) : null,
                      )}
                    </tr>
                  ) : null,
                )}
              </tbody>
            </table>
          </div>
        );
      })()
    ) : n.type === "tableRow" ? (
      <tr><Self nodes={n.content} /></tr>
    ) : n.type === "tableHeader" ? (
      <th colspan={n.attrs?.colspan} rowspan={n.attrs?.rowspan}><Self nodes={n.content} /></th>
    ) : n.type === "tableCell" ? (
      <td colspan={n.attrs?.colspan} rowspan={n.attrs?.rowspan}><Self nodes={n.content} /></td>
    ) : n.type === "quiz" ? (
      // Kuis (D42): markup sama dengan renderer app, dihidupkan enhanceInteractive.
      <form class={`quiz quiz-${quizMode(n.attrs)}`} data-quiz-id={n.attrs.id} data-mode={quizMode(n.attrs)} aria-label={n.attrs.title}>
        <span class="callout-label">{quizLabel(n.attrs)}</span>
        <p class="quiz-title">{n.attrs.title}</p>
        {n.attrs.intro && <p class="quiz-intro">{n.attrs.intro}</p>}
        <ol class="quiz-qs">
          {n.attrs.questions.map((q, qi) => (
            <li><fieldset><legend>{q.q}</legend>
              <div class="quiz-opts">
                {q.options.map((o, oi) => (
                  <label class="quiz-opt"><input type="radio" name={`q${qi}`} value={oi} data-points={quizOptionPoints(n.attrs, o)} data-correct={o.correct ? "1" : undefined} /><span>{o.label}</span></label>
                ))}
              </div>
              {quizMode(n.attrs) === "scale" && n.attrs.ends && (<p class="quiz-ends" aria-hidden="true"><span>{n.attrs.ends[0]}</span><span>{n.attrs.ends[1]}</span></p>)}
              {q.options.map((o, oi) => o.feedback && <p class="quiz-fb" data-for={oi} hidden>{o.feedback}</p>)}
              {q.explain && <p class="quiz-explain" hidden>{q.explain}</p>}
            </fieldset></li>
          ))}
        </ol>
        <ul class="quiz-bands" hidden>
          {n.attrs.results.map((r) => (<li data-min={r.min} data-max={r.max}><b>{r.title}</b>{r.text && <span>{r.text}</span>}</li>))}
        </ul>
        <div class="quiz-result" aria-live="polite" hidden></div>
        <p class="quiz-hint">{quizHint(n.attrs)}</p>
      </form>
    ) : n.type === "toolEmbed" && n.attrs.kind === "template" ? (
      <aside class="tool-embed template-embed">
        <span class="callout-label">Template siap unduh</span>
        <b>{n.attrs.title ?? "Template"}</b>
        {n.attrs.intro && <p>{n.attrs.intro}</p>}
        <a class="template-embed-link" href={appUrl(`/template/${encodeURIComponent(n.attrs.slug)}`)}>Isi & unduh template →</a>
      </aside>
    ) : n.type === "toolEmbed" ? (
      <aside class="tool-embed tool-embed-static">
        <span class="callout-label">Coba langsung</span>
        <b>{n.attrs.title ?? "Kalkulator interaktif"}</b>
        {n.attrs.intro && <p>{n.attrs.intro}</p>}
        <p class="tool-embed-note">Kalkulator ini bisa diisi langsung di aplikasi SelfGrow. <a href={appUrl("/masuk?auto=1")}>Masuk gratis</a></p>
      </aside>
    ) : n.type === "animChart" ? (
      (() => {
        const widths = barWidths(n.attrs.items);
        return (
          <figure class={`anim-chart anim-kind-${n.attrs.kind}`} data-anim="" data-format={n.attrs.format}>
            <figcaption class="anim-title">{n.attrs.title}</figcaption>
            {n.attrs.kind === "bars" ? (
              <div class="anim-bars">
                {n.attrs.items.map((it, i) => (
                  <div class="anim-row"><span class="anim-label">{it.label}</span><span class="anim-track"><span class="anim-bar" style={`--w:${widths[i]}%;--i:${i};${it.color ? `--c:${it.color};` : ""}`}></span></span><span class="anim-num" data-value={it.value}>{formatChartValue(it.value, n.attrs.format)}</span></div>
                ))}
              </div>
            ) : (
              <div class="anim-counters">
                {n.attrs.items.map((it) => (
                  <div class="anim-counter" style={it.color ? `--c:${it.color}` : undefined}><b class="anim-num" data-value={it.value}>{formatChartValue(it.value, n.attrs.format)}</b><span>{it.label}</span></div>
                ))}
              </div>
            )}
            {n.attrs.note && <p class="anim-note">{n.attrs.note}</p>}
          </figure>
        );
      })()
    ) : n.type === "callout" ? (
      <aside class={`callout callout-${n.attrs.variant}`} role="note" aria-label={CALLOUT_LABELS[n.attrs.variant]}><span class="callout-label" aria-hidden="true">{CALLOUT_LABELS[n.attrs.variant]}</span><Self nodes={n.content} /></aside>
    ) : null,
  )
}
