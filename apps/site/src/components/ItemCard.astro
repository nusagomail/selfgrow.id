---
import { isWideCard } from "@selfgrow/shared";
import { type Access, type ContentType, contentPath, siteCover, type VideoInfo } from "../lib/api";
import ToolCard from "./ToolCard.astro";
import VideoCard from "./VideoCard.astro";

/**
 * Kartu buku di etalase (D38): sampul tegak seperti di rak toko buku, judul di bawahnya, dan satu
 * label akses. Dipakai di rak per kategori (gulir ke samping) dan di grid kategori.
 */
interface Props {
  item: {
    type: ContentType;
    slug: string;
    title: string;
    summary: string | null;
    access: Access;
    comingSoon?: boolean;
    coverUrl?: string | null;
    category?: { slug: string; name: string } | null;
    video?: VideoInfo | null;
  };
}
const { item } = Astro.props;
const cover = siteCover(item.coverUrl);
const TYPE_LABEL: Record<ContentType, string> = {
  ebook: "Ebook",
  tool: "Tool",
  template: "Template",
  program: "Program",
  video: "Video",
};
const label = item.comingSoon
  ? { text: "Segera", cls: "soon" }
  : item.access === "free"
    ? { text: "Gratis", cls: "free" }
    : item.access === "preview"
      ? { text: "Bab 1 gratis", cls: "free" }
      : { text: "Premium", cls: "premium" };
---

{item.type === "video" ? (
  <VideoCard item={item} />
) : isWideCard(item.type) ? (
  <ToolCard item={{ ...item, type: item.type as "tool" | "template" }} />
) : (
<a href={contentPath(item)} class="book" title={item.summary ?? item.title}>
  <span class:list={["cover", { empty: !cover }]}>
    {cover ? (
      <img src={cover} alt={`Sampul ${item.title}`} width="200" height="300" loading="lazy" decoding="async" />
    ) : (
      <span class="fallback">
        <span class="fb-type">{TYPE_LABEL[item.type]}</span>
        <span class="fb-title">{item.title}</span>
      </span>
    )}
  </span>
  <span class="title">{item.title}</span>
  <span class:list={["label", label.cls]}>
    {label.cls === "premium" && (
      <svg viewBox="0 0 24 24" width="11" height="11" aria-hidden="true"><path d="M7 10V7a5 5 0 0 1 10 0v3M5 10h14v11H5z" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round" /></svg>
    )}
    {label.text}
  </span>
</a>
)}

<style>
  .book {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
  }
  .cover {
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    border-radius: 3px 8px 8px 3px;
    overflow: hidden;
    background: var(--surface-alt);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 12%),
      0 10px 22px -8px rgb(7 62 31 / 35%);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }
  /* Punggung buku: garis gelap tipis + kilau di sisi kiri sampul. */
  .cover::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgb(0 0 0 / 22%) 0,
      rgb(255 255 255 / 14%) 3px,
      rgb(0 0 0 / 6%) 7px,
      transparent 14px
    );
    pointer-events: none;
  }
  .book:hover .cover,
  .book:focus-visible .cover {
    transform: translateY(-3px);
    box-shadow:
      0 2px 4px rgb(0 0 0 / 12%),
      0 16px 28px -10px rgb(7 62 31 / 45%);
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 12px;
    background: linear-gradient(160deg, var(--green-900, #073e1f), var(--primary, #1d7a34));
    color: #fff;
  }
  .fb-type {
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .fb-title {
    font-weight: 800;
    font-size: 0.95rem;
    line-height: 1.2;
  }
  .title {
    font-weight: 700;
    font-size: 0.9rem;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .label {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .label.free {
    color: var(--primary);
  }
  .label.premium {
    color: var(--muted);
  }
  .label.soon {
    color: var(--gold-ink);
  }
</style>
