// Satu Worker: SPA (aset statis) + API Hono di /api/v1 (BLUEPRINT D14).
// Domain belum dibeli (D15): sementara pakai subdomain workers.dev.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "selfgrow-app",
  "main": "./server/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "placement": { "mode": "smart" },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENVIRONMENT": "local",
    "APP_URL": "http://localhost:5173",
    "SITE_URL": "http://localhost:4321"
  },
  "env": {
    "staging": {
      "name": "selfgrow-app-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_URL": "https://selfgrow-app-staging.workers.dev",
        "SITE_URL": "https://selfgrow-site-staging.workers.dev"
      }
    }
  }
}
