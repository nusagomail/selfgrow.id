// Satu Worker: SPA (aset statis) + API Hono di /api/v1 (BLUEPRINT D14).
// Domain belum dibeli (D15): sementara pakai subdomain workers.dev.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "selfgrow-app",
  "main": "./server/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "placement": { "mode": "smart" },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Nilai top-level = production, supaya deploy tanpa --env tetap aman (gagal tertutup).
  // Nilai lokal (ENVIRONMENT=local, APP_URL localhost) hanya di .dev.vars.
  // ADMIN_EMAILS selalu lewat secret (tidak ditulis di repo).
  "vars": {
    "ENVIRONMENT": "production",
    "APP_URL": "https://app.selfgrow.id",
    "SITE_URL": "https://selfgrow.id"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "selfgrow-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "00000000000000000000000000000000" }],
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "selfgrow-local-content" }],
  // Perlindungan konten (BLUEPRINT bagian 8): rate limit per user & per IP (jendela 60 detik)
  // dan Durable Object penghitung bab per jam untuk deteksi scraping.
  "ratelimits": [
    { "name": "RL_USER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_IP", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "durable_objects": { "bindings": [{ "name": "READ_GUARD", "class_name": "ReadGuard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReadGuard"] }],
  "env": {
    // Staging (D15): alamat workers.dev, APP_URL kosong = pakai origin request.
    // ADMIN_EMAILS dan secret lain diset oleh workflow deploy-staging dari GitHub Secrets.
    "staging": {
      "name": "selfgrow-app-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_URL": "",
        "SITE_URL": "",
        // Cloudflare Access (D17): seluruh staging di balik Access, hanya pemilik akun.
        // Bukan rahasia: AUD & team domain dipakai untuk memverifikasi JWT Access.
        "ACCESS_TEAM_DOMAIN": "throbbing-glitter-55a4.cloudflareaccess.com",
        "ACCESS_AUD": "633781c695d2defefb7a1d8ed04177bd8a5699af74a7986949b4256f13a0feaf"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "selfgrow-staging",
          "database_id": "344e2f0a-093b-410d-8def-7c036bacbe38",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "KV", "id": "a97fc98aff02439797d52c259b48a22f" }],
      "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "selfgrow-staging-content" }],
      "ratelimits": [
        { "name": "RL_USER", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_IP", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } }
      ],
      "durable_objects": { "bindings": [{ "name": "READ_GUARD", "class_name": "ReadGuard" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReadGuard"] }]
    }
  }
}
