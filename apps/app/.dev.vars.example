# Salin ke .dev.vars untuk development lokal. Jangan pernah commit .dev.vars.
# Nilai di wrangler.jsonc adalah production; file ini menimpanya saat `pnpm dev`.
ENVIRONMENT=local
APP_URL=http://localhost:5173
SITE_URL=http://localhost:4321
ADMIN_EMAILS=
BETTER_AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opsional di lokal. Wajib di production.
TURNSTILE_SECRET_KEY=
