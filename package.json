{
  "name": "selfgrow",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @selfgrow/db generate",
    "db:migrate:local": "pnpm --filter @selfgrow/app db:migrate:local",
    "db:migrate:staging": "pnpm --filter @selfgrow/app db:migrate:staging"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "typescript": "7.0.2"
  }
}
